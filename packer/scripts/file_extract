#!/bin/bash

APP_USER="csye6225"
APP_GROUP="csye6225"
APP_DIR="/opt/webapp"
ZIP_FILE="/tmp/webapp.zip"

# Extract application files
echo "Extracting application..."
sudo mkdir -p $APP_DIR
sudo unzip -o "$ZIP_FILE" -d "/opt"


# Remove unwanted __MACOSX files
sudo rm -rf $APP_DIR/__MACOSX

# Set permissions
echo "Setting permissions..."
sudo chown -R $APP_USER:$APP_GROUP $APP_DIR
sudo find $APP_DIR -type d -exec chmod 750 {} \;
sudo find $APP_DIR -type f -exec chmod 640 {} \;

# Install Node.js dependencies as csye6225
echo "Installing dependencies..."
sudo -u $APP_USER /bin/bash <<DEPLOY
# Verify critical files exist
if [[ ! -f "$APP_DIR/package.json" ]]; then
    echo "Critical error: package.json missing!"
    exit 1
fi

# Change to app directory
cd $APP_DIR

# Set alternate cache directory since /home/csye6225 is removed
export NPM_CONFIG_CACHE="/tmp/npm-cache"

# Install dependencies
npm install --omit=dev 

# Validate installation
if [[ ! -d "$APP_DIR/node_modules" ]]; then
    echo "Error: node_modules not created!"
    exit 1
fi
DEPLOY

echo "Deployment successful"

#!/bin/bash

# Define user and group
APP_USER="csye6225"
APP_GROUP="csye6225"
APP_DIR="/opt/webapp"

echo "Creating user and group..."
sudo groupadd -f $APP_GROUP
sudo useradd -M -r -g $APP_GROUP -s /usr/sbin/nologin $APP_USER 2>/dev/null || true

# Remove /home/csye6225 if it exists
if [ -d "/home/$APP_USER" ]; then
    echo "Removing /home/$APP_USER directory..."
    sudo rm -rf /home/$APP_USER
fi

echo "Setting ownership and permissions for $APP_DIR..."
sudo mkdir -p "$APP_DIR"
sudo chown -R $APP_USER:$APP_GROUP "$APP_DIR"
sudo chmod -R 750 "$APP_DIR"

echo "User setup complete."

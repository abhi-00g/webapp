{
    "agent": {
      "metrics_collection_interval": 15,
      "logfile": "var/log/cloudwatch-agent.log"
    },
    "logs": {
      "logs_collected": {
        "files": {
          "collect_list": [
            {
              "file_path": "/var/log/app.log",
              "log_group_name": "app-group",
              "log_stream_name": "app-log-Stream"
            }
          ]
        }
      }
    },
    "metrics": {
      "namespace": "webapp",
      "metrics_collected": {
        "statsd": {
          "service_address": ":8125",
          "metrics_collection_interval": 15,
          "metrics_aggregation_interval": 15
        }
      }
    }
  }